# Copy this file to .env.local and fill in values from your Firebase project console.
# Never commit .env or .env.local — they are gitignored.
# The same codebase works against any Firebase project by swapping these values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: set your Ko-fi profile URL for the Support page donation button.
# Create a free account at https://ko-fi.com then paste your profile URL here.
# Example: VITE_KOFI_URL=https://ko-fi.com/yourname
VITE_KOFI_URL=
